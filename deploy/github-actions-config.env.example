# GitHub 仓库，格式为 owner/repository。
GITHUB_REPOSITORY="wujianping6/gin-ok-service"

# 物理服务器的 SSH 地址和用户。
SERVER_HOST=""
SERVER_USER=""
SERVER_PORT="22"

# 物理服务器上的部署目录及应用监听设置。
DEPLOY_PATH="/opt/gin-ok-service"
APP_BIND_ADDRESS="0.0.0.0"
APP_PORT="8080"

# 填写本机文件的绝对路径，不要把私钥内容直接写在这个文件中。
#
# 创建专用密钥示例：
# ssh-keygen -t ed25519 -f /absolute/path/gin-ok-service-deploy -N "" -C "github-actions gin-ok-service"
#
# 将公钥安装到服务器后，填写私钥路径：
DEPLOY_SSH_KEY_FILE=""

# 从可信网络获取并核验服务器指纹后保存，例如：
# ssh-keyscan -H -p 22 203.0.113.10 > /absolute/path/gin-ok-service-known-hosts
SERVER_KNOWN_HOSTS_FILE=""

# 第一次上传配置时请保持 false。确认服务器准备完成后再修改为 true。
ENABLE_DEPLOY="false"
